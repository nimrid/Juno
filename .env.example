# ==============================================================================
# Jupiter Perpetuals Copilot - Configuration Template
# ==============================================================================
# NO PAYBOX API KEY OR CLI REQUIRED!
# PayBox connects to your AI host (Claude Desktop, Grok, etc.) via native OAuth 2.1
# over https://api.paybox.sh/mcp. This plugin builds the exact Jupiter Perps
# Solana transaction payloads for PayBox's `request_wallet_sign` tool.
# ==============================================================================

# Solana RPC Endpoint (Mainnet recommended for live pool data & mark prices)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Default Solana Wallet (Optional: can also be passed per-tool call from PayBox `list_credentials`)
DEFAULT_SOLANA_WALLET=9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM
DEFAULT_CREDENTIAL_ID=crd_solana_primary

# x402 Micropayment Recipient Wallet
x402_SOLANA_WALLET_ADDRESS=9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM

